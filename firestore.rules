rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cualquiera puede leer los programas (la tienda es pública)
    match /productos/{id} { allow read: if true; allow write: if true; } // cambiar write a false después de cargarlos
    // Las compras sólo se pueden crear
    match /compras/{id} { allow create: if true; }
  }
}
